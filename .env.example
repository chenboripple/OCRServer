# ============================================
# OCR Server 环境变量样例
# ============================================
# 复制为 .env 并按实际填写:
#   cp .env.example .env
#
# Docker 部署:
#   - docker-compose 会自动读取当前目录的 .env 文件
#   - 敏感信息 (TOKEN) 不要提交到 Git
#   - 可使用 Docker Secrets 管理敏感信息 (Swarm 模式)
#
# 原生部署 / systemd:
#   - 使用 EnvironmentFile= 注入
#   - 或在启动前 export 环境变量

# ── 服务 ──
OCR_SERVER_HOST=0.0.0.0
OCR_SERVER_PORT=8000

# ── OCR CLI ──
# Linux npm 全局装好后留空即可(走 PATH);或写绝对路径如 /usr/bin/ocr
OCR_BIN=ocr
OCR_CONCURRENCY=8
OCR_TIMEOUT_MIN=10
REQUEST_TIMEOUT_SEC=900
MAX_CONCURRENT_REVIEWS=2

# ── LLM(内网 anthropic 兼容端点)──
OCR_LLM_URL=your-llm-endpoint-url    # 内网 anthropic 兼容端点,如 http://10.x.x.x:8320
OCR_LLM_TOKEN=your-llm-token
OCR_LLM_MODEL=GLM-AUTO
OCR_USE_ANTHROPIC=true
OCR_NO_UPDATE=true

# ── 审核输出语言 ──
# 写入 ocr config.json 顶层 language 字段,驱动 LLM 用该语言输出问题描述与总结。
# 默认 Chinese(中文)。可设为 English 或任意语言名;留空则沿用 ocr 默认(English)。
REVIEW_LANGUAGE=Chinese

# ── ocr CLI 自动安装配置 ──
# 服务启动时自动检查安装，二进制损坏时自动重装
# OCR_VERSION=1.7.6              # 固定安装版本
# OCR_MIN_SIZE=40000000          # 二进制最小字节 (40MB，防止截断)

# ── GitLab(对接阶段再填)──
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_CLONE_USER=oauth2
GIT_SSL_NO_VERIFY=1              # 内网 GitLab 无合法证书时跳过校验(1=跳过,留空=校验)

# ── 缓存目录 ──
REPO_CACHE_DIR=/var/ocr/repos
WORK_DIR=/var/ocr/work
GIT_COMMAND_TIMEOUT=300          # git 命令超时(秒),大仓库需更长

# ── 卡点策略 ──
BLOCKING_SEVERITIES=critical,high

# ── Webhook ──
# 在 GitLab 项目 Settings → Integrations 里配置:
#   - URL: http://your-server:8000/gitlab/codeReview
#   - Secret Token: 与下方一致
#   - Trigger: Merge request events
WEBHOOK_SECRET=

# ── 存储 ──
STORAGE_PATH=/var/ocr/ocr.db

# ── 并发背压 ──
# 队列满了返回 503 让 GitLab 重试
MAX_QUEUED_TASKS=10

# ── 飞书电子表格集成 ──
# 每次 code review 前从飞书电子表格读取自定义规则,更新到 ocr 配置
# 表格格式:第一列任意(如序号),第二列为审核规则文本
# FEISHU_ENABLED=true
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_SPREADSHEET_TOKEN=xxxxxxxx  # 飞书电子表格 URL 中的 spreadsheet_token
# FEISHU_SHEET_RANGE=Sheet1!A:B      # 读取范围,默认取 A、B 两列
# OCR_CONFIG_PATH=~/.opencodereview/config.json  # ocr 配置文件路径,飞书规则写入此处

# ── 审核触发策略 ──
# 目标分支为以下分支时始终触发 OCR 审核,否则仅当 MR 标题前缀(去空白转小写)为此值时才触发
# REQUIRED_REVIEW_BRANCHES=master,release
# REVIEW_TITLE_TRIGGER=ocr
